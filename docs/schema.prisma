// ==============================================================================
// UBa Judo Club — Production Database Schema (Prisma Specification)
// University of Bamenda, Bambili Campus
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// Models
// ------------------------------------------------------------------------------

/// User authentication profile linked directly to Supabase Auth (`auth.users.id`).
/// Governs system authentication, permissions, and administrative access.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  role      String   @default("member")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Optional 1-to-1 association with a club athlete
  member Member?

  @@map("profiles")
}

/// Normalized athlete entity on the dojo roster.
/// Uses capitalized belt_rank ("White", "Yellow", "Orange", "Green", "Blue", "Brown", "Black").
model Member {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String?   @unique @map("profile_id") @db.Uuid
  fullName  String    @map("full_name")
  matricule String?   @unique
  program   String?
  beltRank  String    @default("White") @map("belt_rank")
  status    String    @default("active")
  joinedOn  DateTime? @default(now()) @map("joined_on") @db.Date
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  profile             Profile?              @relation(fields: [profileId], references: [id], onDelete: SetNull)
  attendances         Attendance[]
  coordinatedSessions SessionCoordinator[]
  convertedFrom       JoinRequest?          @relation("ConvertedMember")

  @@index([status])
  @@index([beltRank])
  @@map("members")
}

/// Dojo training session schedule, syllabus, and duration.
/// `startTime` contains both the session date and starting timestamp.
model TrainingSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startTime DateTime  @map("start_time") @db.Timestamptz(6)
  endTime   DateTime? @map("end_time") @db.Timestamptz(6)
  focus     String?
  coach     String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  coordinators SessionCoordinator[]
  attendances  Attendance[]
  media        SessionMedia[]

  @@index([startTime])
  @@map("training_sessions")
}

/// Relational junction allowing multiple coordinators (drawn from Member) per session.
model SessionCoordinator {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  role      String?  @default("Lead")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([memberId])
  @@map("session_coordinators")
}

/// Photos and technique/drill videos captured during training sessions.
model SessionMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  url          String
  publicId     String?  @map("public_id")
  thumbnailUrl String?  @map("thumbnail_url")
  mediaType    String   @default("IMAGE") @map("media_type")
  caption      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_media")
}

/// Pure junction entity recording individual tatami attendances.
model Attendance {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([memberId])
  @@map("attendances")
}

/// Prospective athlete submissions from the public `/join` page.
model JoinRequest {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName          String   @map("full_name")
  email             String
  phone             String?
  program           String?
  experience        String?
  message           String?
  status            String   @default("new")
  convertedMemberId String?  @unique @map("converted_member_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  convertedMember Member? @relation("ConvertedMember", fields: [convertedMemberId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("join_requests")
}

/// Club events, tournaments, seminars, and belt promotion trials.
model ClubEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  kind        String
  startDate   DateTime  @map("start_date") @db.Timestamptz(6)
  endDate     DateTime? @map("end_date") @db.Timestamptz(6)
  location    String?
  description String?
  isPublished Boolean   @default(false) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("events")
}
