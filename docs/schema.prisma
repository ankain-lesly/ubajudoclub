// ==============================================================================
// UBa Judo Club — Production Database Schema (Prisma Specification)
// University of Bamenda, Bambili Campus
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// Enums (Standardized UPPERCASE)
// ------------------------------------------------------------------------------

enum Role {
  COACH
  MEMBER
  ADMIN
}

enum BeltRank {
  WHITE
  YELLOW
  ORANGE
  GREEN
  BLUE
  BROWN
  BLACK
}

enum MemberStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum JoinRequestStatus {
  NEW
  CONTACTED
  JOINED
  DECLINED
}

enum MediaType {
  IMAGE
  VIDEO
}

// ------------------------------------------------------------------------------
// Models
// ------------------------------------------------------------------------------

/// User authentication profile linked directly to Supabase Auth (`auth.users.id`).
/// Governs system authentication, permissions, and administrative access.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  role      Role     @default(MEMBER)
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Optional 1-to-1 association with a club athlete
  member Member?

  @@map("profiles")
}

/// Normalized athlete entity on the dojo roster.
/// Can exist independently on the dojo roster, and can optionally link
/// to a user `Profile` when the student creates an online account.
model Member {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId       String?      @unique @map("profile_id") @db.Uuid
  fullName        String       @map("full_name")
  matricule       String?      @unique
  program         String?
  currentBelt     BeltRank     @default(WHITE) @map("current_belt")
  beltAwardedDate DateTime?    @default(now()) @map("belt_awarded_date") @db.Date
  status          MemberStatus @default(ACTIVE)
  joinedOn        DateTime?    @default(now()) @map("joined_on") @db.Date
  phone           String?
  email           String?
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  profile             Profile?              @relation(fields: [profileId], references: [id], onDelete: SetNull)
  attendances         Attendance[]
  coordinatedSessions SessionCoordinator[]
  convertedFrom       JoinRequest?          @relation("ConvertedMember")

  @@index([status])
  @@index([currentBelt])
  @@map("members")
}

/// Dojo training session schedule, syllabus, and duration.
/// `startTime` contains both the session date and starting timestamp, avoiding date desync.
model TrainingSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startTime DateTime  @map("start_time") @db.Timestamptz(6)
  endTime   DateTime? @map("end_time") @db.Timestamptz(6)
  focus     String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  coordinators SessionCoordinator[]
  attendances  Attendance[]
  media        SessionMedia[]

  @@index([startTime])
  @@map("training_sessions")
}

/// Relational junction allowing multiple coordinators (drawn from Member) per session.
/// Composite unique index covers `sessionId` on the left; explicit index covers `memberId`.
model SessionCoordinator {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  role      String?  @default("Lead") // e.g. "Lead", "Assistant", "Guest Sensei"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([memberId])
  @@map("session_coordinators")
}

/// Photos and technique/drill videos captured during training sessions.
/// Stores `publicId` and `thumbnailUrl` for clean Cloudinary/storage asset lifecycle management.
model SessionMedia {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  url          String
  publicId     String?   @map("public_id")
  thumbnailUrl String?   @map("thumbnail_url")
  mediaType    MediaType @default(IMAGE) @map("media_type")
  caption      String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_media")
}

/// Pure junction entity recording individual tatami attendances.
/// Composite unique index covers `sessionId` on the left; explicit index covers `memberId`.
model Attendance {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([memberId])
  @@map("attendances")
}

/// Prospective athlete submissions from the public `/join` page.
/// Links to `convertedMemberId` when approved to prevent duplicate account creation.
model JoinRequest {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName          String            @map("full_name")
  email             String
  phone             String?
  program           String?
  experience        String?
  message           String?
  status            JoinRequestStatus @default(NEW)
  convertedMemberId String?           @unique @map("converted_member_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  convertedMember Member? @relation("ConvertedMember", fields: [convertedMemberId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("join_requests")
}
